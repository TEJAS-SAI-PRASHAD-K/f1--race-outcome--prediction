#!/bin/sh
# Conventional Commits validator. Pure POSIX shell: no Node, no commitlint.
# Enable with:  git config core.hooksPath .githooks
#
# Format:  <type>(<scope>): <subject>
#   - header <= 72 chars
#   - subject lowercase, imperative, no trailing period
#   - optional "!" before the colon marks a breaking change

MSG_FILE="$1"
# First line that is not a comment and not blank.
HEADER=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1)

TYPES='feat|fix|docs|refactor|perf|test|build|ci|chore|revert|style'
SCOPES='db|ingest|features|models|backtest|tune|predict|config|deps|scripts|docs|repo'

fail() {
    echo "ERROR: $1" >&2
    echo >&2
    echo "  got:      $HEADER" >&2
    echo "  expected: <type>(<scope>): <subject>" >&2
    echo "  types:    $TYPES" >&2
    echo "  scopes:   $SCOPES" >&2
    echo >&2
    echo "  e.g. feat(features): add rolling teammate qualifying delta" >&2
    exit 1
}

# Merge and revert commits are generated by git; let them through.
case "$HEADER" in
    "Merge "*|"Revert "*) exit 0 ;;
esac

[ -n "$HEADER" ] || fail "empty commit message"

if [ "${#HEADER}" -gt 72 ]; then
    fail "header is ${#HEADER} chars, limit is 72"
fi

if ! printf '%s' "$HEADER" | grep -Eq "^($TYPES)(\\(($SCOPES)\\))?!?: .+$"; then
    fail "header does not match the conventional commit format"
fi

SUBJECT=${HEADER#*: }

case "$SUBJECT" in
    *.) fail "subject must not end with a period" ;;
esac

# Reject a capitalised first letter: subjects are lowercase and imperative.
if printf '%s' "$SUBJECT" | cut -c1 | grep -q '[A-Z]'; then
    fail "subject must start lowercase"
fi

exit 0
